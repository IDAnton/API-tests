{
  "$schema": "https://json-schema.org",
  "properties": {
    "page": {
      "type": "integer",
      "minimum": 0
    },
    "per_page": {
      "type": "integer",
      "minimum": 0
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "total_pages": {
      "type": "integer",
      "minimum": 0
    },
    "support": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "foramt": "uri"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "text"
      ]
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "first_name": {
            "type": "string",
            "minLength": 1
          },
          "last_name": {
            "type": "string",
            "minLength": 1
          },
          "avatar": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://reqres.in/img/faces"
          }
        },
        "required": [
          "id",
          "email",
          "first_name",
          "last_name",
          "avatar"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "page",
    "per_page",
    "total",
    "total_pages",
    "data"
  ]
}